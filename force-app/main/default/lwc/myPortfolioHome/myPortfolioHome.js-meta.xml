<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>My Portfolio Home</masterLabel>
    <description>Personalized Private Client portfolio home experience.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <property name="customerId" type="String" label="Customer Id" description="Bank_Customer__c record Id to render."/>
        </targetConfig>
        <targetConfig targets="lightning__RecordPage">
            <property name="customerId" type="String" label="Customer Id Override" description="Optional Bank_Customer__c record Id. Use this on non-Bank Customer record pages such as Contact."/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>